    "@poker/protocol": "0.0.0",
    "argon2": "0.45.2",
    "fastify": "5.12.8",
    "ics": "3.12.1",
    "luxon": "3.7.2",
    "pg": "8.23.1",
    "socket.io": "4.8.4",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
